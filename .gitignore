.DS_Store
*.swp
.idea/
.vscode/

# never commit real secrets. Secrets come from 1Password via External
# Secrets Operator; the two bootstrap credentials it can't fetch for itself
# (docs/cloudflare-1password-setup.md, step 7) are created by hand and must
# never land here.
*.secret.yaml
secrets.yaml
secrets/
1password-credentials.json
*.credentials.json

# Book reader (reader/). The repo is public, so book text never goes in it:
# converted books and the local dev data dir stay on your machine only.
reader/books/
reader/data/
*.book.zip
reader/web/node_modules/
reader/web/dist/
